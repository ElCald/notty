<resources xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base application theme. -->
    <style name="Base.Theme.Notty" parent="Theme.AppCompat.NoActionBar">
        <!-- Customize your dark theme here. -->
        <item name="colorPrimary">@color/grey</item>
        <item name="colorSecondary">@color/light_grey</item>
        <item name="colorPrimaryDark">@color/dark_grey</item>

        <item name="colorPrimaryFixed">@color/cream</item>
        <item name="colorSecondaryFixed">@color/light_grey</item>

    </style>

    <style name="stylePage">
        <item name="android:background">@color/grey</item>
    </style>

    <style name="styleNoteTile">
        <item name="android:backgroundTint">@color/light_grey</item>
        <item name="android:textColor">@color/white</item>
    </style>


    <style name="styleNoteTile_selected">
        <item name="android:backgroundTint">@color/lighter_grey</item>
    </style>

    <style name="styleNoteTile_fav">
        <item name="android:tint">@color/dark_cream</item>
    </style>

    <style name="styleNoteTile_locker">
        <item name="android:tint">@color/dark_grey</item>
    </style>


    <style name="styleDirectoryTile">
        <item name="android:background">@color/light_grey</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="styleDirectoryTile_selected">
        <item name="android:background">@color/lighter_grey</item>
    </style>


    <style name="styleSettingsTile">
        <item name="android:background">@color/light_grey</item>
        <item name="android:textColor">@color/white</item>
    </style>




    <style name="styleToolbar">
        <item name="android:background">#00000000</item>
    </style>

    <style name="styleToolbar_Title">
        <item name="android:textColor">@color/cream</item>
    </style>

    <style name="styleToolbar_Option">
        <item name="android:tint">@color/white</item>
    </style>



    <style name="styleFootbar">
        <item name="android:background">@color/dark_grey</item>
    </style>

    <style name="styleFootbar_addBtn">
        <item name="android:tint">@color/cream</item>
    </style>

    <style name="styleFootbar_favBtn">
        <item name="android:tint">@color/cream</item>
    </style>

    <style name="styleFootbar_searchBtn">
        <item name="android:tint">@color/cream</item>
    </style>

    <style name="styleFootbar_directoryBtn">
        <item name="android:tint">@color/cream</item>
    </style>

    <style name="styleFootbar_optionsBtn">
        <item name="android:tint">@color/cream</item>
    </style>


    <style name="styleOptionsHome">
        <item name="android:background">@color/dark_grey</item>
    </style>

    <style name="styleOptionsHome_btn">
        <item name="android:textColor">@color/white</item>
    </style>


    <style name="stylePageCreate_backBtn">
        <item name="android:tint">@color/dark_cream</item>
    </style>

    <style name="stylePageCreate_edit">
        <item name="android:backgroundTint">@color/light_cream</item>
        <item name="android:textColor">@color/light_cream</item>
    </style>



    <style name="stylePageRead_Title">
        <item name="android:textColor">@color/light_cream</item>
    </style>

    <style name="stylePageRead_Content">
        <item name="android:textColor">@color/light_cream</item>
    </style>

    <style name="stylePageRead_Date">
        <item name="android:textColor">@color/light_grey</item>
    </style>

    <style name="stylePageRead_Directory">
        <item name="android:textColor">@color/dark_cream</item>
    </style>

    <style name="stylePageRead_BackBtn">
        <item name="android:tint">@color/dark_cream</item>
    </style>

    <style name="stylePageRead_ModifyBtn">
        <item name="android:tint">@color/dark_cream</item>
    </style>

</resources>