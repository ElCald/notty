<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Notty" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <item name="colorPrimary">@color/grey</item>
        <item name="colorSecondary">@color/light_grey</item>
        <item name="colorPrimaryDark">@color/dark_grey</item>

        <item name="colorPrimaryFixed">@color/cream</item>
        <item name="colorSecondaryFixed">@color/light_grey</item>

        <item name="option_icon">@drawable/options_white</item>
        <item name="add_icon">@drawable/add_icon_white</item>
        <item name="favorite_icon">@drawable/etoile_white_empty</item>
        <item name="not_favorite_icon">@drawable/etoile_white_filled</item>
        <item name="search_icon">@drawable/loupe_white</item>
        <item name="back_icon">@drawable/left_arrow_white</item>
    </style>

    <style name="stylePage">
        <item name="android:background">@color/grey</item>
    </style>

    <style name="styleNoteTile">
        <item name="android:backgroundTint">@color/light_grey</item>
        <item name="android:textColor">@color/white</item>
    </style>



    <style name="styleToolbar">
        <item name="android:background">#00000000</item>
    </style>

    <style name="styleToolbar_Title">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="styleToolbar_Option">
        <item name="android:src">@drawable/options_white</item>
    </style>



    <style name="styleFootbar">
        <item name="android:background">@color/dark_grey</item>
    </style>

    <style name="styleFootbar_addBtn">
        <item name="android:src">@drawable/add_icon_white</item>
    </style>

    <style name="styleFootbar_favBtn">
        <item name="android:src">@drawable/etoile_white_empty</item>
    </style>

    <style name="styleFootbar_searchBtn">
        <item name="android:src">@drawable/loupe_white</item>
    </style>



    <style name="stylePageCreate_backBtn">
        <item name="android:src">@drawable/left_arrow_grey</item>
    </style>

    <style name="stylePageCreate_edit">
        <item name="android:backgroundTint">@color/white</item>
    </style>



    <style name="stylePageRead_Title">
        <item name="android:textColor">@color/light_grey</item>
    </style>

    <style name="stylePageRead_Content">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="stylePageRead_Date">
        <item name="android:textColor">@color/light_grey</item>
    </style>

    <style name="stylePageRead_BackBtn">
        <item name="android:src">@drawable/left_arrow_grey</item>
    </style>

    <style name="stylePageRead_ModifyBtn">
        <item name="android:src">@drawable/crayon_grey</item>
    </style>

</resources>