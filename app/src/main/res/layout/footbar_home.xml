<!--        android:layout_height="match_parent"-->
<!--        android:src="@drawable/recherche"-->
<!--        android:layout_marginHorizontal="20dp"-->
<!--        style="@style/styleFootbar_searchBtn"/>-->

    <ImageView
        android:id="@+id/id_home_toolbar_btn_addNote"
        android:layout_width="50dp"
        android:layout_height="match_parent"
        android:src="@drawable/ajouter"
        android:layout_marginHorizontal="80dp"
        android:paddingVertical="10dp"
        style="@style/styleFootbar_addBtn"/>


    <ImageView
        android:id="@+id/id_home_toolbar_btn_options"
        android:layout_width="50dp"
        android:layout_height="match_parent"
