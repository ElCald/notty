<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/id_home_options"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    style="@style/styleOptionsHome">

    <TextView
        android:id="@+id/id_options_home_btn_sort"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:paddingVertical="10dp"
        android:gravity="center"
        android:text="@string/sort"
        style="@style/styleOptionsHome_btn"/>

    <TextView
        android:id="@+id/id_options_home_btn_export"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:paddingVertical="10dp"
        android:gravity="center"
        android:text="@string/optn_export"
        style="@style/styleOptionsHome_btn"/>

    <TextView
        android:id="@+id/id_options_home_btn_import"
        android:layout_width="match_parent"
        android:height="50dp"
        android:paddingVertical="10dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/optn_import"
        style="@style/styleOptionsHome_btn"/>

    <TextView
        android:id="@+id/id_options_home_btn_deleteAll"
        android:layout_width="match_parent"
        android:height="50dp"
        android:paddingVertical="10dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/optn_deleteAll"
        style="@style/styleOptionsHome_btn"/>

    <TextView
        android:id="@+id/id_options_home_btn_credits"
        android:layout_width="match_parent"
        android:height="50dp"
        android:paddingVertical="10dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/credits"
        style="@style/styleOptionsHome_btn"/>
</LinearLayout>