<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ReadNoteActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/id_read_btn_backHome"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:backgroundTint="#FF000000"
            android:gravity="center" />

        <TextView
            android:id="@+id/id_read_text_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ems="10"
            android:text="Titre"
            android:gravity="center" />

        <Button
            android:id="@+id/id_read_btn_modify"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:backgroundTint="#620A0A"
            android:gravity="center" />
    </LinearLayout>

    <TextView
        android:id="@+id/id_read_text_dateModif"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="01/01/1990"
        android:textAlignment="textEnd" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="10dp">

        <TextView
            android:id="@+id/id_read_text_body"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ems="10"
            android:gravity="top"
            android:scrollbars="vertical"
            android:text="Contenu"
            android:textSize="16sp" />

    </ScrollView>

</LinearLayout>