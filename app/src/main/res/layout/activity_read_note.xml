<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ReadNoteActivity"
    style="@style/stylePage">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/id_read_btn_backHome"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_weight="0"
            android:layout_gravity="center"
            android:layout_margin="20dp"
            style="@style/stylePageRead_BackBtn" />

        <TextView
            android:id="@+id/id_read_text_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ems="10"
            android:gravity="center"
            android:text="Titre"
            android:textSize="20sp"
            android:textStyle="bold"
            style="@style/stylePageRead_Title"/>

        <ImageView
            android:id="@+id/id_read_btn_modify"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_weight="0"
            android:layout_gravity="center"
            android:layout_margin="20dp"
            style="@style/stylePageRead_ModifyBtn" />
    </LinearLayout>

    <TextView
        android:id="@+id/id_read_text_dateModif"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="01/01/1990"
        android:textAlignment="textEnd"
        style="@style/stylePageRead_Date"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="15dp">

        <TextView
            android:id="@+id/id_read_text_body"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ems="10"
            android:gravity="top"
            android:scrollbars="vertical"
            android:text="Contenu"
            android:textSize="16sp"
            style="@style/stylePageRead_Content"/>

    </ScrollView>

</LinearLayout>